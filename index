<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Manual do Qualificador — Embrapa Milho e Sorgo</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,400;0,600;0,700;1,400&family=Source+Sans+3:wght@300;400;500;600;700&display=swap" rel="stylesheet">
<style>

/* ===== RESET & VARS (Baseado no modelo index 6) ===== */
*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

:root {
  --green-dark: #1a4a2e;
  --green-mid: #2d7a4f;
  --green-light: #4caf74;
  --green-pale: #e8f5ee;
  --green-ultra: #f2faf5;
  --amber: #e8a020;
  --amber-light: #fff8e8;
  --blue: #1a6fa0;
  --blue-light: #e8f4fc;
  --red-light: #fff0f0;
  --red: #c0392b;
  --text-dark: #1a2e1e;
  --text-mid: #3d5a42;
  --text-light: #6b8570;
  --border: #d4e8da;
  --bg-page: #eef2ef;
  --white: #ffffff;
  --sidebar-w: 240px;
  --content-max: 820px;
}

/* ===== LAYOUT ===== */
html, body {
  height: 100%;
  font-family: 'Source Sans 3', sans-serif;
  background: var(--bg-page);
  color: var(--text-dark);
  overflow: hidden;
}

.app {
  display: flex;
  height: 100vh;
  width: 100vw;
  overflow: hidden;
}

/* ===== SIDEBAR ===== */
.sidebar {
  width: var(--sidebar-w);
  min-width: var(--sidebar-w);
  height: 100vh;
  background: var(--green-dark);
  display: flex;
  flex-direction: column;
  overflow: hidden;
  position: relative;
  z-index: 10;
  box-shadow: 3px 0 20px rgba(0,0,0,0.22);
}

.sidebar-brand {
  padding: 28px 20px 20px;
  border-bottom: 1px solid rgba(255,255,255,0.1);
  flex-shrink: 0;
}
.sidebar-brand-icon {
  font-size: 22px;
  margin-bottom: 8px;
  display: block;
}
.sidebar-brand-name {
  font-family: 'Lora', serif;
  font-size: 13px;
  font-weight: 700;
  color: var(--green-light);
  line-height: 1.4;
  letter-spacing: 0.2px;
}
.sidebar-brand-sub {
  font-size: 10px;
  color: rgba(255,255,255,0.35);
  margin-top: 4px;
  text-transform: uppercase;
  letter-spacing: 1px;
}

.sidebar-nav {
  flex: 1;
  overflow-y: auto;
  padding: 12px 10px;
}

.nav-item {
  display: flex;
  align-items: center;
  gap: 10px;
  width: 100%;
  padding: 9px 12px;
  border-radius: 8px;
  border: none;
  background: transparent;
  color: rgba(255,255,255,0.6);
  font-family: 'Source Sans 3', sans-serif;
  font-size: 12.5px;
  font-weight: 500;
  text-align: left;
  cursor: pointer;
  transition: all 0.18s;
  margin-bottom: 2px;
}
.nav-item:hover { background: rgba(255,255,255,0.08); color: rgba(255,255,255,0.9); }
.nav-item.active { background: var(--green-light); color: var(--green-dark); font-weight: 700; }

.sidebar-footer { padding: 14px 20px; border-top: 1px solid rgba(255,255,255,0.08); flex-shrink: 0; }
.progress-label { font-size: 10px; color: rgba(255,255,255,0.35); text-transform: uppercase; margin-bottom: 6px; }
.progress-track { height: 3px; background: rgba(255,255,255,0.12); border-radius: 2px; overflow: hidden; }
.progress-fill { height: 100%; background: var(--green-light); transition: width 0.5s ease; width: 0%; }

/* ===== MAIN CONTENT ===== */
.main {
  flex: 1;
  height: 100vh;
  overflow-y: auto;
  padding: 40px 48px 60px;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.page { display: none; width: 100%; max-width: var(--content-max); animation: fadeUp 0.35s ease; }
.page.active { display: block; }
@keyframes fadeUp { from { opacity: 0; transform: translateY(16px); } to { opacity: 1; transform: translateY(0); } }

/* ===== COVER ===== */
.cover {
  background: linear-gradient(150deg, #0a1f10 0%, #1a4a2e 50%, #0f2d1a 100%);
  min-height: 100vh; display: flex; flex-direction: column; justify-content: center; padding: 80px 10%; margin: -40px -48px -60px; width: calc(100% + 96px);
}
.cover h1 { font-family: 'Lora', serif; font-size: 48px; color: white; margin-bottom: 20px; }
.cover-sub { font-size: 18px; color: white; opacity: 0.9; margin-bottom: 40px; font-weight: 300; }
.cover-btn { background: var(--green-light); color: var(--green-dark); border: none; padding: 16px 36px; border-radius: 40px; font-weight: 700; cursor: pointer; }

/* ===== COMPONENTS ===== */
.chapter-badge { display: flex; align-items: center; gap: 10px; font-size: 11px; font-weight: 700; text-transform: uppercase; color: var(--green-mid); margin-bottom: 14px; }
.chapter-badge-line { width: 32px; height: 2px; background: var(--green-light); }
.page h1 { font-family: 'Lora', serif; font-size: 32px; color: var(--green-dark); margin-bottom: 8px; }
.page-subtitle { font-size: 16px; color: var(--text-light); margin-bottom: 30px; border-bottom: 1px solid var(--border); padding-bottom: 20px; }
.field-card { background: white; border: 1px solid var(--border); border-radius: 12px; margin: 20px 0; overflow: hidden; }
.field-card-header { background: var(--green-dark); color: white; padding: 12px 20px; font-weight: 700; font-size: 14px; }
.field-card-body { padding: 20px; }
.callout { border-radius: 8px; padding: 16px; margin: 15px 0; display: flex; gap: 12px; font-size: 14px; border-left: 4px solid transparent; }
.callout.dica { background: var(--green-pale); border-color: var(--green-light); }
.callout.atencao { background: var(--amber-light); border-color: var(--amber); }
.callout.importante { background: var(--red-light); border-color: var(--red); }
.highlight-box { background: linear-gradient(135deg, var(--green-dark), var(--green-mid)); color: white; border-radius: 12px; padding: 25px; margin: 20px 0; }
.table-wrap { overflow-x: auto; margin: 20px 0; border: 1px solid var(--border); border-radius: 8px; }
table { width: 100%; border-collapse: collapse; font-size: 14px; }
th { background: #f8faf9; padding: 12px; text-align: left; border-bottom: 2px solid var(--border); color: var(--green-dark); }
td { padding: 12px; border-bottom: 1px solid var(--border); }
.prompt-box { background: #222; color: #a5d6a7; padding: 20px; border-radius: 8px; font-family: monospace; margin: 15px 0; white-space: pre-wrap; font-size: 13px; }

.toc-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 15px; margin: 20px 0; }
.toc-card { background: white; border: 1px solid var(--border); padding: 20px; border-radius: 10px; cursor: pointer; transition: 0.2s; }
.toc-card:hover { transform: translateY(-3px); border-color: var(--green-light); box-shadow: 0 5px 15px rgba(0,0,0,0.05); }

.page-nav { display: flex; justify-content: space-between; margin-top: 40px; padding-top: 20px; border-top: 1px solid var(--border); }
.btn { padding: 10px 20px; border-radius: 6px; border: none; font-weight: 600; cursor: pointer; }
.btn-primary { background: var(--green-dark); color: white; }
.btn-secondary { background: var(--green-pale); color: var(--green-dark); }

</style>
</head>
<body>
<div class="app">

  <aside class="sidebar">
    <div class="sidebar-brand">
      <span class="sidebar-brand-icon">📋</span>
      <div class="sidebar-brand-name">Manual do Qualificador</div>
      <div class="sidebar-brand-sub">Embrapa Milho e Sorgo</div>
    </div>
    <nav class="sidebar-nav" id="sidebarNav"></nav>
    <div class="sidebar-footer">
      <div class="progress-label">Progresso</div>
      <div class="progress-track"><div class="progress-fill" id="progressFill"></div></div>
    </div>
  </aside>

  <main class="main" id="mainContent">
    
    <!-- PAG 0: CAPA -->
    <section class="page active" id="page-0">
      <div class="cover">
        <h1>Manual do Qualificador</h1>
        <div class="cover-sub">Guia prático para análise mercadológica, regulatória e de parcerias no processo de qualificação de ativos tecnológicos.</div>
        <button class="cover-btn" onclick="goTo(1)">Iniciar Guia →</button>
      </div>
    </section>

    <!-- PAG 1: SUMARIO -->
    <section class="page" id="page-1">
      <div class="chapter-badge"><div class="chapter-badge-line"></div>Conteúdo</div>
      <h1>Sumário</h1>
      <div class="toc-grid">
        <div class="toc-card" onclick="goTo(2)"><strong>1. Introdução</strong><p>O papel do qualificador e o que é o processo.</p></div>
        <div class="toc-card" onclick="goTo(3)"><strong>2. O Processo</strong><p>Fluxo do CTI ao Gestec.</p></div>
        <div class="toc-card" onclick="goTo(4)"><strong>3. Uso da Planilha</strong><p>Regras de edição e colaboração.</p></div>
        <div class="toc-card" onclick="goTo(5)"><strong>4. Guia de Leitura</strong><p>Análise das abas preenchidas pelo Pesquisador.</p></div>
        <div class="toc-card" onclick="goTo(6)"><strong>5. Caracterização Mercadológica</strong><p>Análise de mercado e Concorrência.</p></div>
        <div class="toc-card" onclick="goTo(7)"><strong>6. SWOT e Modelo</strong><p>Estratégia e inserção no mercado.</p></div>
        <div class="toc-card" onclick="goTo(8)"><strong>7. Parcerias e Regulatório</strong><p>Aspectos legais, PI e contratos.</p></div>
        <div class="toc-card" onclick="goTo(9)"><strong>8. Finalização</strong><p>Como enviar e validar os dados.</p></div>
      </div>
    </section>

    <!-- PAG 2: INTRODUÇÃO -->
    <section class="page" id="page-2">
      <div class="chapter-badge"><div class="chapter-badge-line"></div>Capítulo 1</div>
      <h1>Introdução</h1>
      <p class="page-subtitle">O que é a qualificação e seu papel nela.</p>
      
      <div class="highlight-box">
        A qualificação de ativos é o processo pelo qual a Embrapa formaliza, organiza e avalia o potencial de transferência de tecnologias. É aqui que um resultado de pesquisa vira um <strong>ativo tecnológico</strong>.
      </div>

      <h2>O papel do Qualificador</h2>
      <p>Você é o agente de TT responsável por transformar o conhecimento científico em uma proposta de valor clara para o mercado.</p>
      <div class="field-card">
        <div class="field-card-header">Suas responsabilidades de preenchimento:</div>
        <div class="field-card-body">
          <ul>
            <li><strong>Descrição Inicial:</strong> Nome do ativo (se novo).</li>
            <li><strong>Caracterização Mercadológica:</strong> Mercado, concorrência, SWOT e negócio.</li>
            <li><strong>Parcerias e Regulatório:</strong> Aspectos legais, PI e parceiros.</li>
          </ul>
        </div>
      </div>
      
      <div class="page-nav">
        <button class="btn btn-secondary" onclick="goTo(1)">Anterior</button>
        <button class="btn btn-primary" onclick="goTo(3)">Próximo</button>
      </div>
    </section>

    <!-- PAG 3: PROCESSO -->
    <section class="page" id="page-3">
        <div class="chapter-badge"><div class="chapter-badge-line"></div>Capítulo 2</div>
        <h1>Processo de Qualificação</h1>
        <p>O fluxo envolve a integração entre CTI, Gestor, Pesquisador e você.</p>
        
        <div class="field-card">
            <div class="field-card-header">Fluxo de Trabalho</div>
            <div class="field-card-body">
                <ol>
                    <li>CTI aprova resultado.</li>
                    <li>Gestor configura a planilha Google Sheets.</li>
                    <li>Pesquisador preenche dados técnicos.</li>
                    <li><strong>Qualificador (Você) realiza a análise de mercado e parcerias.</strong></li>
                    <li>Gestor revisa e insere no Gestec.</li>
                </ol>
            </div>
        </div>
        <div class="page-nav">
            <button class="btn btn-secondary" onclick="goTo(2)">Anterior</button>
            <button class="btn btn-primary" onclick="goTo(4)">Próximo</button>
        </div>
    </section>

    <!-- PAG 4: COMO USAR -->
    <section class="page" id="page-4">
        <div class="chapter-badge"><div class="chapter-badge-line"></div>Capítulo 3</div>
        <h1>Como usar a planilha</h1>
        <div class="callout importante">
            A planilha é editada exclusivamente via <strong>Google Sheets</strong>. Não faça download para Excel, pois isso quebra a colaboração em tempo real.
        </div>
        <div class="field-card">
            <div class="field-card-header">Dicas Práticas</div>
            <div class="field-card-body">
                <ul>
                    <li>Campos brancos: texto livre.</li>
                    <li>Campos cinzas: listas suspensas.</li>
                    <li>Nova linha na célula: <strong>Alt + Enter</strong>.</li>
                    <li>Não altere a Coluna A ou a estrutura da planilha.</li>
                </ul>
            </div>
        </div>
        <div class="page-nav">
            <button class="btn btn-secondary" onclick="goTo(3)">Anterior</button>
            <button class="btn btn-primary" onclick="goTo(5)">Próximo</button>
        </div>
    </section>

    <!-- PAG 5: GUIA DE LEITURA -->
    <section class="page" id="page-5">
        <div class="chapter-badge"><div class="chapter-badge-line"></div>Capítulo 4</div>
        <h1>Guia de Leitura (Abas do Pesquisador)</h1>
        <p>Antes de escrever, você precisa entender o que o pesquisador declarou.</p>
        
        <div class="field-card">
            <div class="field-card-header">Aba: Caracterização do Ativo</div>
            <div class="field-card-body">
                <p>Observe especialmente:</p>
                <ul>
                    <li><strong>Problemas resolvidos:</strong> Ajuda a entender as "dores" do mercado.</li>
                    <li><strong>Inovação:</strong> Define o diferencial competitivo para sua SWOT.</li>
                    <li><strong>Validação Técnica:</strong> Indica a TRL real e prontidão.</li>
                </ul>
            </div>
        </div>
        <div class="callout dica">
            Dúvida no que o pesquisador escreveu? Use os <strong>comentários do Google Sheets</strong> e marque-o (@nome) para esclarecer pontos técnicos antes de iniciar sua análise.
        </div>
        <div class="page-nav">
            <button class="btn btn-secondary" onclick="goTo(4)">Anterior</button>
            <button class="btn btn-primary" onclick="goTo(6)">Próximo</button>
        </div>
    </section>

    <!-- PAG 6: CARACTERIZAÇÃO MERCADOLÓGICA -->
    <section class="page" id="page-6">
        <div class="chapter-badge"><div class="chapter-badge-line"></div>Capítulo 5</div>
        <h1>Caracterização Mercadológica</h1>
        <p>Aqui você define o posicionamento do ativo.</p>
        
        <div class="field-card">
            <div class="field-card-header">Análise de Concorrência</div>
            <div class="field-card-body">
                <p>Identifique quem compete com a Embrapa. <strong>Pergunta-chave:</strong> O que o produtor usa hoje para resolver esse problema?</p>
                <div class="prompt-box">
"Atue como especialista em agro. Mapeie concorrentes para:
- Cultura: [Milho]
- Problema: [Enfezamento]
- Diferencial: [Tolerância genética]..."
                </div>
            </div>
        </div>

        <div class="table-wrap">
            <table>
                <tr><th>Fonte</th><th>Link/Recurso</th></tr>
                <tr><td>Cultivares</td><td>RNC / SNPC (MAPA)</td></tr>
                <tr><td>Sementes</td><td>Córtex Embrapa</td></tr>
                <tr><td>Bioinsumos</td><td>Agrofit / App Bioinsumos</td></tr>
            </table>
        </div>
        <div class="page-nav">
            <button class="btn btn-secondary" onclick="goTo(5)">Anterior</button>
            <button class="btn btn-primary" onclick="goTo(7)">Próximo</button>
        </div>
    </section>

    <!-- PAG 7: SWOT E MODELO -->
    <section class="page" id="page-7">
        <div class="chapter-badge"><div class="chapter-badge-line"></div>Capítulo 6</div>
        <h1>SWOT e Estratégia</h1>
        
        <div class="field-card">
            <div class="field-card-header">Matriz SWOT</div>
            <div class="field-card-body">
                <p>Consolide as Forças, Fraquezas, Oportunidades e Ameaças. Use o <strong>NotebookLM</strong> ou <strong>ChatGPT</strong> colando a aba do pesquisador para gerar um rascunho inicial.</p>
            </div>
        </div>

        <div class="field-card">
            <div class="field-card-header">Modelo de Negócio (Indicação de Inserção)</div>
            <div class="field-card-body">
                <ul>
                    <li><strong>Parceria PD&I:</strong> Para ativos em desenvolvimento (Cooperação Técnica).</li>
                    <li><strong>Licenciamento:</strong> Para ativos prontos (Exploração de Cultivar/Patente).</li>
                    <li><strong>Gratuito/Know-how:</strong> Para softwares ou treinamentos.</li>
                </ul>
            </div>
        </div>
        <div class="page-nav">
            <button class="btn btn-secondary" onclick="goTo(6)">Anterior</button>
            <button class="btn btn-primary" onclick="goTo(8)">Próximo</button>
        </div>
    </section>

    <!-- PAG 8: PARCERIAS E REGULATÓRIO -->
    <section class="page" id="page-8">
        <div class="chapter-badge"><div class="chapter-badge-line"></div>Capítulo 7</div>
        <h1>Parcerias e Regulatório</h1>
        
        <div class="field-card">
            <div class="field-card-header">Checklist Regulatório</div>
            <div class="field-card-body">
                <p>Para cada item, informe Sim/Não e os documentos:</p>
                <ul>
                    <li><strong>Patrimônio Genético (SisGen):</strong> Fundamental para biodiversidade.</li>
                    <li><strong>Biossegurança (CTNBio):</strong> Obrigatório para transgênicos (OGM).</li>
                    <li><strong>Propriedade Intelectual:</strong> Verifique com o CLPI (Fernanda Almeida).</li>
                </ul>
            </div>
        </div>
        <div class="callout dica">
            <strong>Dica de Ouro:</strong> Um contrato SAIC ou processo SEI bem lido geralmente contém todos os dados de parceiros (CNPJ, percentuais) que você precisa para esta aba.
        </div>
        <div class="page-nav">
            <button class="btn btn-secondary" onclick="goTo(7)">Anterior</button>
            <button class="btn btn-primary" onclick="goTo(9)">Próximo</button>
        </div>
    </section>

    <!-- PAG 9: FINALIZAÇÃO -->
    <section class="page" id="page-9">
        <div class="chapter-badge"><div class="chapter-badge-line"></div>Capítulo 8</div>
        <h1>Finalização e Contatos</h1>
        
        <div class="field-card">
            <div class="field-card-header">Fluxo de Encerramento</div>
            <div class="field-card-body">
                <ol>
                    <li>Notifique o gestor por e-mail (julia.resende@embrapa.com.br).</li>
                    <li>O Gestor valida os campos.</li>
                    <li>O PDF é gerado e enviado ao Pesquisador.</li>
                </ol>
            </div>
        </div>

        <h2>Suporte</h2>
        <div class="table-wrap">
            <table>
                <tr><td>Dúvidas Planilha</td><td>Julia Miranda</td></tr>
                <tr><td>Propriedade Intelectual</td><td>Fernanda Almeida (CLPI)</td></tr>
                <tr><td>Regulatório</td><td>Maria José Vilaça</td></tr>
            </table>
        </div>

        <div class="page-nav">
            <button class="btn btn-secondary" onclick="goTo(8)">Anterior</button>
            <button class="btn btn-primary" onclick="goTo(0)">Voltar ao Início</button>
        </div>
    </section>

  </main>
</div>

<script>
const chapters = [
  { label: 'Capa', icon: '🏠' },
  { label: 'Sumário', icon: '📋' },
  { label: '1. Introdução', icon: '01' },
  { label: '2. Processo', icon: '02' },
  { label: '3. Uso da Planilha', icon: '03' },
  { label: '4. Guia de Leitura', icon: '04' },
  { label: '5. Mercadológica', icon: '05' },
  { label: '6. SWOT e Estratégia', icon: '06' },
  { label: '7. Regulatório', icon: '07' },
  { label: '8. Finalização', icon: '08' }
];

let current = 0;
const totalPages = chapters.length;

function buildSidebar() {
  const nav = document.getElementById('sidebarNav');
  chapters.forEach((ch, i) => {
    const btn = document.createElement('button');
    btn.className = 'nav-item' + (i === 0 ? ' active' : '');
    btn.innerHTML = `<span style="width:20px; opacity:0.6; font-weight:700;">${ch.icon}</span><span>${ch.label}</span>`;
    btn.onclick = () => goTo(i);
    nav.appendChild(btn);
  });
}

function goTo(n) {
  document.getElementById('page-' + current).classList.remove('active');
  document.querySelectorAll('.nav-item')[current].classList.remove('active');
  current = n;
  document.getElementById('page-' + current).classList.add('active');
  document.querySelectorAll('.nav-item')[current].classList.add('active');
  document.getElementById('mainContent').scrollTo({ top: 0, behavior: 'smooth' });
  updateProgress();
}

function updateProgress() {
  const pct = Math.round(((current + 1) / totalPages) * 100);
  document.getElementById('progressFill').style.width = pct + '%';
}

buildSidebar();
updateProgress();
</script>
</body>
</html>
